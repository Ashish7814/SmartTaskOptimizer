using SmartTaskOptimizer.Domain.Entities;

namespace SmartTaskOptimizer.Domain.Repositories.Tasks;

public class TaskssRepository : ITaskssRepository
{
    private readonly List<TaskItems> _tasks = new();

    public List<TaskItems> GetAll()
    {
        return _tasks;
    }

    public TaskItems Add(TaskItems task)
    {
        task.Id = _tasks.Count + 1;

        _tasks.Add(task);

        return task;
    }

    public TaskItems? GetById(int id)
    {
        return _tasks.FirstOrDefault(x => x.Id == id);
    }
}
