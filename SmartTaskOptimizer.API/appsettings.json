{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "SmartTaskOptimizer",
    "Audience": "SmartTaskOptimizerUsers",
    "ExpirationMinutes": 60
  },
  "Hangfire": {
    "Enabled": true
  },
  "Cors": {
    "Origins": ["https://localhost:4200"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
